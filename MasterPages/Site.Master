<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="QP_WEBPROJECT.vs2.MasterPages.Site" %>

<!DOCTYPE html>
<html lang="tr">
<head runat="server">
    <meta charset="utf-8" />
    <title>Quiz Platformu</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #EDE5F9;
            color: #5B0E2D;
        }

        .navbar {
            background-color: #F6EEF9;
            box-shadow: 0 2px 8px rgba(91, 14, 45, 0.1);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: #5B0E2D !important;
        }

        .nav-link {
            color: #5B0E2D !important;
            font-weight: 500;
        }

        .nav-link:hover {
            color: #FFF4B0 !important;
        }

        footer {
            background-color: #5B0E2D;
            color: #FFF4B0;
            padding: 18px 0;
            text-align: center;
            position: fixed;
            bottom: 0;
            width: 100%;
        }

        .container {
            padding-bottom: 90px;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
<form runat="server">

    <!-- 🔹 NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/Pages/Public/Default.aspx">Quiz Platformu</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">

                    <!-- 🔓 GUEST -->
                    <asp:PlaceHolder ID="phGuest" runat="server">
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/User/Login.aspx">
                                <i class="fa fa-user"></i> Giriş Yap
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/User/Register.aspx">
                                <i class="fa fa-user-plus"></i> Üye Ol
                            </a>
                        </li>
                    </asp:PlaceHolder>

                    <!-- 👤 NORMAL USER -->
                    <asp:PlaceHolder ID="phUser" runat="server" Visible="false">
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="fa fa-user-circle"></i>
                                <asp:Label ID="lblTopUserName" runat="server" />
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/User/Profile.aspx">
                                <i class="fa fa-id-card"></i> Profilim
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/User/UserDashboard.aspx">
                                <i class="fa fa-list-check"></i> Testlerim
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/User/Settings.aspx">
                                <i class="fa fa-gear"></i> Ayarlar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/User/Logout.aspx">
                                <i class="fa fa-sign-out-alt"></i> Çıkış
                            </a>
                        </li>
                    </asp:PlaceHolder>

                    <!-- 🛡 ADMIN -->
                    <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                        <li class="nav-item">
                            <span class="nav-link fw-bold">
                                <i class="fa fa-user-shield"></i>
                                <asp:Label ID="lblAdminName" runat="server" />
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/Admin/AdminDashboard.aspx">
                                <i class="fa fa-gauge"></i> Admin Paneli
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/Admin/AdminProfile.aspx">
                                <i class="fa fa-id-card"></i> Profil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/Admin/AdminLogout.aspx">
                                <i class="fa fa-sign-out-alt"></i> Çıkış
                            </a>
                        </li>
                    </asp:PlaceHolder>

                </ul>
            </div>
        </div>
    </nav>

    <!-- 🔹 CONTENT -->
    <div class="container mt-5">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>

    <!-- 🔹 FOOTER -->
    <footer>
        &copy; <%: DateTime.Now.Year %> Quiz Platformu | Eğlence & Karakter Testleri
    </footer>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
